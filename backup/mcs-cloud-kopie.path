# Pi-MCS: Nach jedem gelungenen Backup die Cloud-Kopie anstoßen.
#
# minecraft-backup.sh schreibt ganz am Ende .neuestes-backup. Über diese
# Datei statt über OnSuccess= in mcs-backup.service, weil ein Backup auf
# drei Wegen entsteht (Timer, "mcs backup", Knopf in der Weboberfläche) und
# nur der erste über systemd läuft. Die Datei schreiben alle drei.
#
# Hängt an multi-user.target, nicht an mcs.target: Es wartet nur, und ohne
# Server entstehen keine Backups, die es melden könnte.

[Unit]
Description=Pi-MCS: nach jedem Backup die Cloud-Kopie anstoßen

[Path]
PathChanged=/home/pi/mcs/mcs_backup/.neuestes-backup
Unit=mcs-cloud-kopie.service

[Install]
WantedBy=multi-user.target
