# PiCraft: neuestes Backup auf den USB-Stick MCS-BACKUP.
#
# Gestartet von der udev-Regel (Stick eingesteckt) und von
# mcs-usb-kopie.path (neues Backup fertig). Steckt kein Stick, endet der
# Lauf sofort ohne Fehler.
#
# Läuft als root, weil nur root einhängen darf — die Dateien selbst kopiert
# und prüft das Skript als Benutzer des Servers (Begründung im Kopf von
# backup/usb-kopie.sh). Deshalb liegt es unter /usr/local/lib/picraft/ und
# nicht im beschreibbaren Backup-Ordner.

[Unit]
Description=PiCraft USB-Kopie (neuestes Backup auf den Stick)

[Service]
Type=oneshot
# Bewusst KEIN EnvironmentFile=mcs.conf, anders als bei allen anderen
# Einheiten: Die Datei gehört dem Benutzer, und ihre Variablen landeten in
# einem root-Prozess — BASH_ENV oder LD_PRELOAD genügten für root-Rechte.
# Das Skript liest drei Schlüssel selbst und prüft sie. Vertraut wird nur
# diesen beiden Zeilen; deploy.sh setzt Benutzer und Pfad ein.
Environment=MCS_USER=pi
Environment=MCS_CONF=/home/pi/mcs/mcs.conf
ExecStart=/usr/bin/bash /usr/local/lib/picraft/usb-kopie.sh
StateDirectory=picraft
RuntimeDirectory=picraft-usb
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1h
# Eingehängt wird in einem eigenen Namensraum: Nur dieser Lauf sieht den
# Stick, und stirbt er, verschwindet die Einhängung mit ihm, statt als
# Leiche stehen zu bleiben.
PrivateMounts=yes
ProtectHome=read-only
ProtectSystem=full
PrivateNetwork=yes
PrivateTmp=yes
