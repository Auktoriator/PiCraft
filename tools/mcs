#!/bin/bash
#
# mcs — Das zentrale Kommandozeilen-Werkzeug für den Pi-MCS Minecraft-Server.
#
# Ein Befehl für alles, statt vieler einzelner Skripte:
#
#   mcs start        Server starten
#   mcs stop         Server stoppen (mit Vorwarnung für Spieler)
#   mcs restart      Server neu starten
#   mcs an           Pi-MCS komplett einschalten (Server, Web, Backup, DNS)
#   mcs aus          Pi-MCS komplett abschalten — bleibt auch nach Neustart aus
#   mcs status       Statusübersicht (Dienst, Spieler, CPU, RAM, Backup, ...)
#   mcs console      Live-Serverkonsole öffnen (Verlassen: Strg+A, dann D)
#   mcs cmd <...>    Einen Minecraft-Befehl an den Server schicken
#   mcs rcon <...>   Einen Befehl schicken und die ANTWORT anzeigen
#   mcs say <...>    Eine Chat-Nachricht an alle Spieler senden
#   mcs backup       Backup sofort erstellen (ohne Server-Unterbrechung)
#   mcs restore      Ein Backup zurückspielen (fragt vorher nach)
#                    --probe   nur prüfen, ohne etwas zu verändern
#   mcs update       Paper auf den neuesten Build bringen (gleiche Minecraft-Version)
#   mcs plugins      Plugins mit der Liste im Repo abgleichen
#   mcs version      Welche Versionen gerade laufen
#   mcs hardware     Gerät, Arbeitsspeicher und Speichermedium anzeigen
#   mcs melden       Testnachricht aufs Handy schicken (ntfy)
#   mcs erreichbarkeit  Kommen Mitspieler von aussen rein? (erkennt DS-Lite)
#   mcs dns          Dauerhafter Name im Internet (deSEC/DuckDNS)
#   mcs usb          Kopie auf den USB-Stick: Stand, von Hand anstossen
#   mcs cloud        Verschluesselte Kopie in der Cloud: Stand, Probe, Einrichten
#   mcs config-diff  Unterschiede zwischen Repo und Installation zeigen
#   mcs log          Server-Log live mitlesen (Beenden: Strg+C)
#
# Wird von install.sh nach /usr/local/bin/mcs kopiert und ist dann
# überall im Terminal verfügbar.

# set -e beendet das Skript, sobald ein Befehl fehlschlägt. Vorher lief es
# ohne — und meldete deshalb "Minecraft-Server gestoppt." auch dann, wenn
# systemctl gescheitert war.
set -euo pipefail

# ----------------------------------------------------------------------------
# Pfade — alle aus der zentralen mcs.conf
# ----------------------------------------------------------------------------
# Wo liegt die Installation, wenn mcs.conf (noch) fehlt? Im Heimatverzeichnis
# des Benutzers, dem der Server gehört. Bis 2026-08-28 stand hier fest
# "/home/pi" — auf jedem Pi mit einem anderen Benutzernamen zeigte der
# Rückfallwert damit stumm ins Leere. Siehe CLAUDE.md.
MCS_HOME="${HOME:-/home/$(id -un)}"
MCS_CONF="${MCS_CONF:-$MCS_HOME/mcs/mcs.conf}"
# shellcheck source=/dev/null
if [ -f "$MCS_CONF" ]; then . "$MCS_CONF"; fi

DIENST="${MCS_SERVICE_NAME:-minecraft.service}"
MC_DIR="${MCS_DIR:-$MCS_HOME/mcs}"
MC_SERVER_DIR="${MCS_SERVER_DIR:-$MC_DIR/mc_server}"
BACKUP_DIR="${MCS_BACKUP_DIR:-$MC_DIR/mcs_backup}"
BACKUP_SKRIPT="${MCS_BACKUP_SCRIPT:-$BACKUP_DIR/minecraft-backup.sh}"
UPDATE_SKRIPT="${MCS_UPDATE_SCRIPT:-$MC_SERVER_DIR/paper-update.sh}"
PLUGIN_SKRIPT="$MC_SERVER_DIR/plugin-update.sh"
ADMIN_DIR="${MCS_ADMIN_DIR:-$MC_DIR/admin}"
ADMIN_APP="$ADMIN_DIR/app.py"
# Der Sitzungsname steht in lib-konsole.sh (KONSOLE_SITZUNG) und wird von
# dort gelesen — hier stand bis 2026-08-26 eine zweite, inzwischen
# unbenutzte Kopie davon.
SERVER_LOG="${MCS_MINECRAFT_LOG:-$MC_SERVER_DIR/logs/latest.log}"
REPO_DIR="${MCS_REPO_DIR:-$MCS_HOME/Pi-MCS}"

# ----------------------------------------------------------------------------
# Hilfsfunktionen
# ----------------------------------------------------------------------------
# Hauptschalter: läuft Pi-MCS überhaupt?
# ----------------------------------------------------------------------------
# "mcs aus" deaktiviert mcs.target. Danach startet beim Booten nichts mehr —
# weder Server noch Weboberfläche, Protokoll oder Backup. Mehrere Befehle
# müssen das wissen, damit sie nicht Erfolg melden, wo nichts passieren kann.
mcs_abgeschaltet() {
  # "is-enabled" liefert bei einem unbekannten Target ebenfalls einen Fehler.
  # Das ist hier richtig so: Wer noch die alte Installation ohne mcs.target
  # hat, soll nicht plötzlich Warnungen sehen — deshalb gilt nur ein
  # ausdrückliches "disabled" als abgeschaltet.
  [ "$(systemctl is-enabled mcs.target 2>/dev/null)" = "disabled" ]
}

# ----------------------------------------------------------------------------

# Der Umgang mit der Server-Konsole steht seit 2026-08-26 an einer einzigen
# Stelle: lib-konsole.sh im Serververzeichnis. Von dort kommen
# konsole_laeuft, konsole_senden und konsole_anhaengen — samt dem Escaping
# der Rückwärtsschrägstriche, das früher hier stand.
# shellcheck source=../server/lib-konsole.sh
# Fehlt die Bibliothek, wuerde "set -e" hier zuschlagen - und damit auch
# "mcs status", also genau das Werkzeug, mit dem man den Fehler suchen
# wuerde. Deshalb eine verstaendliche Meldung statt eines stummen Abbruchs.
KONSOLE_LIB="${MCS_SERVER_DIR:-$MCS_HOME/mcs/mc_server}/lib-konsole.sh"
if [ ! -f "$KONSOLE_LIB" ]; then
  echo "Fehler: $KONSOLE_LIB fehlt." >&2
  echo "Die Installation ist unvollstaendig. Beheben mit:" >&2
  echo "    cd ~/Pi-MCS && ./deploy.sh" >&2
  exit 1
fi
# shellcheck source=../server/lib-konsole.sh
. "$KONSOLE_LIB"

# Wie konsole_senden, bricht aber mit einer verständlichen Meldung ab, wenn
# der Server gar nicht läuft. Ohne diese Prüfung liefe der Befehl ins Leere
# und man stünde vor einer wortlosen Fehlermeldung von screen.
senden_mit_pruefung() {
  if ! konsole_laeuft; then
    echo "Fehler: Der Server läuft nicht — Befehl kann nicht gesendet werden." >&2
    exit 1
  fi
  konsole_senden "$1"
}

# Meldet, wenn das jüngste Backup zu alt ist oder das letzte fehlschlug.
#
# Warum eine eigene Funktion, obwohl das Admin-Tool dasselbe kann? Weil das
# Admin-Tool optional ist — und die Backup-Lücke vom 2026-05-18 bis
# 2026-07-27 wäre genau dann aufgefallen, wenn diese Meldung überall
# erschienen wäre.
backup_alter_melden() {
  local GRENZE="${MCS_BACKUP_WARNUNG_STUNDEN:-48}"
  local NEUESTES ALTER_STD FEHLER_DATEI="$BACKUP_DIR/.letzter-fehler"

  # Ist Pi-MCS abgeschaltet, laeuft auch der Backup-Timer nicht — dann ist ein
  # altes Backup kein Fehler, sondern die Folge einer Entscheidung. Ohne diese
  # Ausnahme meldete "mcs status" nach zwei Tagen Sommerpause einen Ausfall,
  # den es gar nicht gibt. Alarm, der falsch liegt, wird nicht mehr gelesen.
  if mcs_abgeschaltet; then
    echo ""
    echo "Pi-MCS ist abgeschaltet (mcs aus) — es werden keine Backups erstellt."
    if [ -f "$FEHLER_DATEI" ]; then
      echo "Letzter Backup-Fehlschlag vor dem Abschalten: $(cat "$FEHLER_DATEI")"
    fi
    return 0
  fi

  NEUESTES=$(find "$BACKUP_DIR" -maxdepth 1 -name 'backup_*.tar.gz' -printf '%T@ %p\n' 2>/dev/null \
             | sort -rn | head -n1 | cut -d' ' -f2-)

  echo ""
  if [ -z "$NEUESTES" ]; then
    echo "!!! ACHTUNG: Es gibt überhaupt kein Backup."
    echo "    Sofort eines anlegen: mcs backup"
  else
    ALTER_STD=$(( ($(date +%s) - $(stat -c %Y "$NEUESTES")) / 3600 ))
    if [ "$ALTER_STD" -gt "$GRENZE" ]; then
      echo "!!! ACHTUNG: Das neueste Backup ist $ALTER_STD Stunden alt (gemeldet ab $GRENZE h)."
      echo "    Läuft der nächtliche Timer noch?  systemctl list-timers mcs-backup.timer"
      echo "    Protokoll ansehen: cat $BACKUP_DIR/backup.log"
    else
      echo "Letztes Backup: $(basename "$NEUESTES") (vor $ALTER_STD h) — in Ordnung."
    fi
  fi

  if [ -f "$FEHLER_DATEI" ]; then
    echo "!!! Letzter Backup-Fehlschlag: $(cat "$FEHLER_DATEI")"
  fi
}

