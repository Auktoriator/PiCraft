# versions.env — Welche Versionen dieser Server benutzt.
#
# Warum gibt es diese Datei? Vorher zog jede Installation und jedes Update
# einfach "die neueste" Paper-Version. Zwei Klone dieses Repos an
# verschiedenen Tagen ergaben damit zwei verschiedene Server — und, viel
# schlimmer: ein Sprung auf eine neue Minecraft-Version wandelt beim
# nächsten Start die Weltdateien um. Diese Umwandlung ist ENDGÜLTIG. Die
# alte Serverversion kann die umgewandelte Welt nicht mehr öffnen.
#
# Deshalb steht hier fest, welche Version installiert wird. Ein Wechsel
# ist damit eine bewusste Entscheidung mit einem Commit — kein Nebeneffekt.
#
# Von Hand muss hier niemand etwas eintragen. Die drei Paper-Werte unten
# schreibt "mcs update" selbst — in die Installation und ins Repository,
# dort mit einem Commit:
#
#   mcs update --pruefen            nachsehen, was es Neues gibt
#   mcs update                      neuester Build derselben Minecraft-Version
#                                   (nur Fehlerkorrekturen; geht auch über den
#                                   Knopf in der Weboberfläche)
#   mcs update --minecraft 26.3     Versionswechsel, legt vorher ein Backup an
#
# Welcher Build wann festgelegt wurde: git log server/versions.env

# --- Java -------------------------------------------------------------------
# Mindestversion: darunter startet der Server überhaupt nicht.
MCS_JAVA_MIN=21

# Empfohlene Version: bringt -XX:+UseCompactObjectHeaders mit (8 statt 12
# Byte je Objektkopf, spürbar weniger Heap-Druck auf dem Cortex-A76).
# Ist sie nicht installiert, läuft der Server trotzdem — die Option wird
# dann automatisch weggelassen.
MCS_JAVA_EMPFOHLEN=25

# --- PaperMC ----------------------------------------------------------------
# Was eine Erstinstallation lädt (install.sh: paper-update.sh --festgelegt),
# und was deploy.sh in die Installation kopiert. Keine Kommentare zum
# Stand hier hinein: Die Werte ändert ein Skript, ein Kommentar daneben
# veraltete beim ersten Update.
MCS_MINECRAFT_VERSION=26.3
MCS_PAPER_BUILD=211
MCS_PAPER_SHA256=f3a5953094696578193b38fa2831e86db254dfbf4817b1ac6cfca55a2d18ca94
